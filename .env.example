# --- Anthropic (idea del modello + caption) ---
ANTHROPIC_API_KEY=sk-ant-...
# opzionale, default: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Gemini (generazione dell'immagine) ---
# https://aistudio.google.com/apikey — serve la fatturazione attiva:
# i modelli immagine non hanno free tier.
GEMINI_API_KEY=AIza...
# opzionale. Alternative: gemini-3.1-flash-image, gemini-3-pro-image
GEMINI_MODEL=gemini-3.1-flash-lite-image

# --- TikTok (https://developers.tiktok.com) ---
TIKTOK_CLIENT_KEY=aw...
TIKTOK_CLIENT_SECRET=...
# deve combaciare ESATTAMENTE con la redirect URI registrata nell'app TikTok
TIKTOK_REDIRECT_URI=http://localhost:5173/callback

# porta del server locale usato solo da `npm run auth`
AUTH_PORT=5173

# opzionale: percorso di ffmpeg, se non è nel PATH
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
